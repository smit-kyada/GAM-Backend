# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

#ASSETS
ASSETS

# Package-lock
package-lock.json

# Try file
try.js

yarn.lock

yarn-error.log

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Enviroment files
.env
