                <p style="padding-top: 4pt;text-indent: 0pt;text-align: left;"><br /></p>
                <p class="s3" style="padding-left: 5pt;text-indent: 0pt;line-height: 13pt;text-align: left;">Name: <span
                        class="s5">
                        <!-- <%=fName%> <%=lName%> -->
                        <%= fName ? `${fName} ${lName}` : userName %>
                    </span></p>
            </td>
        </tr>
        <tr style="height:12pt">
            <td
                style="width:194pt;border-left-style:solid;border-left-width:1pt;border-bottom-style:solid;border-bottom-width:1pt;border-right-style:solid;border-right-width:1pt">
                <p class="s3" style="padding-left: 5pt;text-indent: 0pt;line-height: 10pt;text-align: left;">
                    Designation: <b>Director</b></p>
            </td>
            <td
                style="width:194pt;border-left-style:solid;border-left-width:1pt;border-bottom-style:solid;border-bottom-width:1pt;border-right-style:solid;border-right-width:1pt">
                <p class="s3" style="padding-left: 5pt;text-indent: 0pt;line-height: 10pt;text-align: left;">
                    Designation: <b>
                        <%= Designation ? `${Designation}` : `Proprietorship` %>
                    </b></p>
            </td>
        </tr>
    </table>
</body>

</html>